# Everything is optional except a reachable MongoDB. Missing keys => labelled fallback, never fake data.

# --- Core ---
MONGODB_URI=mongodb://localhost:27017        # Mongo connection (Atlas: mongodb+srv://user:pass@cluster.mongodb.net)
MONGODB_DB=nivara                            # database name
BUSINESS_TZ=Asia/Kolkata                     # calendar dates for orders, briefs, forecasts
PORT=3000                                    # HTTP port (`npm start` reads process.env.PORT)
LOG_LEVEL=info                               # pino level (silent in tests)
# NODE_ENV=production                        # Sentry environment tag (default development)
# NODE_VERSION=24                            # Render build only: Node major to install (set in render.yaml)

# --- Gemma (open-weight). LLM_PROVIDER picks the host; missing host/key → keyword router + templates ---
LLM_PROVIDER=ollama                          # ollama (default) or gemini (Google AI Studio REST)
OLLAMA_BASE_URL=http://localhost:11434       # Ollama or any OpenAI-compatible host; /v1 is appended automatically
GEMMA_MODEL=gemma3:4b                        # Ollama tag: gemma3:1b, gemma3:12b, ...
# OLLAMA_API_KEY=                            # Bearer token if the Ollama host sits behind a proxy
# GEMINI_API_KEY=                            # Google AI Studio key; required for LLM_PROVIDER=gemini, else templates
# GEMINI_MODEL=gemma-4-26b-a4b-it            # Gemini API Gemma id (default, fast MoE); alt: gemma-4-31b-it
# AGENT_MODE=                                # ollama only: 'mastra' forces native tool calling, 'router' never uses it

# --- Forecasting (TabPFN, python subprocess) ---
# TABPFN_PYTHON=forecast/.venv/bin/python    # python that has TabPFN installed
# TABPFN_TOKEN=                              # Prior Labs licence key → newest TabPFN weights; unset → TabPFN v2 (ungated)
# TABPFN_MODEL_VERSION=v2                    # force a version: v2, v2.5, v2.6, v3, ...
# TABPFN_DEVICE=cpu                          # torch device for TabPFN
# FORECAST_MODE=fallback                     # skip TabPFN, use labelled moving average
# TABPFN_ESTIMATORS=4                        # TabPFN ensemble size
# TABPFN_TIMEOUT_MS=180000                   # kill the forecast subprocess after this many ms

# --- Partner integrations (each degrades gracefully when unset) ---
TIGER_DATABASE_URL=                          # Tiger Data (Timescale + pgvector) service URL; unset → Mongo sales + keyword catalog search
# GEMINI_API_KEY also powers gemini-embedding-001 for hybrid searchCatalog (FTS-only without it)
SERPAPI_API_KEY=                             # Google Shopping supplier search (gl=in)
BACKBOARD_API_KEY=                           # long-term memory mirror
# BACKBOARD_ASSISTANT_ID=                    # reuse an existing Backboard assistant (else one is created)
ELEVENLABS_API_KEY=                          # Scribe STT (Hindi/Hinglish voice notes) + TTS
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # TTS voice id
# ELEVENLABS_STT_MODEL=scribe_v1             # speech-to-text model
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5     # text-to-speech model
SENTRY_DSN=                                  # agent tracing (init in src/instrument.ts, preloaded via --import)
# SENTRY_TRACES_SAMPLE_RATE=1                # Sentry traces sample rate
# SENTRY_SEND_CONTENT=1                      # also send prompts/answers/tool I/O (redacted by default)
# SUPPLIER_REFRESH_MAX=5                     # SerpApi searches per Temporal supplier refresh (at-risk first, then catalogue)
# MIN_SUPPLIER_SAVING_RUPEES=10              # supplier saving counts for attention only if ≥ ₹ AND ≥ % below
# MIN_SUPPLIER_SAVING_PERCENT=5              # percent half of the supplier-saving threshold

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233              # unset = server doesn't dial, workflows run in-process; Cloud: <ns>.<acct>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=default                   # Temporal namespace
# TEMPORAL_API_KEY=                          # Temporal Cloud API key (enables TLS)
# TEMPORAL_UI_URL=http://localhost:8233      # Temporal UI link shown in /api/workflows
# BRIEF_CRON=0 8 * * *                       # daily brief schedule on the worker
SUPPLIER_FAIL_FIRST_N=0                      # demo: supplier activity fails first N attempts, Temporal retries
