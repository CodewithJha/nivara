# Everything is optional except a reachable MongoDB. Missing keys => labelled fallback, never fake data.

# --- Core ---
MONGODB_URI=mongodb://localhost:27017        # Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=nivara
BUSINESS_TZ=Asia/Kolkata
PORT=3000

# --- Gemma (open-weight) via any OpenAI-compatible endpoint; default local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434       # or https://your-gpu-droplet:11434 ; /v1 is appended automatically
GEMMA_MODEL=gemma3:4b                        # any Ollama tag: gemma3:1b, gemma3:12b, ...
# OLLAMA_API_KEY=                            # only if your hosted endpoint needs a Bearer token
# AGENT_MODE=                                # 'mastra' = force native tool calling, 'router' = never use it

# --- Forecasting (TabPFN, python subprocess) ---
# TABPFN_PYTHON=forecast/.venv/bin/python
# TABPFN_TOKEN=                              # Prior Labs licence key → newest TabPFN weights; unset → TabPFN v2 (ungated)
# TABPFN_MODEL_VERSION=v2                    # force a version: v2, v2.5, v2.6, v3, ...
# FORECAST_MODE=fallback                     # skip TabPFN, use labelled moving average
# TABPFN_ESTIMATORS=4
# TABPFN_TIMEOUT_MS=180000

# --- Partner integrations (each degrades gracefully when unset) ---
SERPAPI_API_KEY=                             # Google Shopping supplier search
BACKBOARD_API_KEY=                           # long-term memory mirror
# BACKBOARD_ASSISTANT_ID=                    # reuse an existing Backboard assistant (else one is created)
ELEVENLABS_API_KEY=                          # Scribe STT + TTS
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SENTRY_DSN=                                  # agent tracing (init in src/instrument.ts, preloaded via --import)
# SENTRY_SEND_CONTENT=1                      # also send prompts/answers/tool I/O (redacted by default)
# SUPPLIER_REFRESH_MAX=3                     # SerpApi searches per Temporal supplier refresh
# MIN_SUPPLIER_SAVING_RUPEES=10              # supplier saving counts for attention only if ≥ ₹ AND ≥ % below
# MIN_SUPPLIER_SAVING_PERCENT=5

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233              # Temporal Cloud: <ns>.<acct>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=                          # Temporal Cloud API key (enables TLS)
# TEMPORAL_UI_URL=http://localhost:8233
# BRIEF_CRON=0 8 * * *
SUPPLIER_FAIL_FIRST_N=0                      # demo: supplier activity fails first N attempts, Temporal retries
